# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time.

# Backend origin, read at runtime on the server only (never NEXT_PUBLIC_, so one image serves every
# environment). The browser calls same-origin /api/..., proxied by src/app/api/[...path]/route.ts.
TRELLIS_BACKEND_URL=http://localhost:8080

# Set to "standalone" for the container build (the Dockerfile); leave unset for `pnpm start`.
TRELLIS_NEXT_OUTPUT=

# In-browser mock backend: true (all domains) | false (none) | comma list, e.g. auth,notification
# Domains: auth, notification, config
NEXT_PUBLIC_MOCK_DOMAINS=false

# Analytics provider: none | console
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
